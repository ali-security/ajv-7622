  /* CVE-2025-69873: when `pattern` comes from $data the regex string is
     attacker-controlled. We construct it at runtime and wrap the call in
     try/catch so an invalid regex string fails validation gracefully (it does
     NOT mitigate ReDoS -- catastrophic backtracking does not throw). For real
     ReDoS resistance pass a linear-time engine via `code.regExp`, e.g.
       new Ajv({$data: true, code: {regExp: require('re2')}})
     This mirrors the upstream v8 fix in ajv@720a23f.

     The `typeof self !== "undefined" && self && self._opts ...` chain keeps
     this snippet safe when `self` is unavailable (ajv-pack standalone
     validators) or resolves to the browser global (Window has no `_opts`).
     In those environments we silently fall back to the native RegExp. */
  var {{=$valid}} = true;
  try {
    {{=$valid}} = new ((typeof self !== 'undefined' && self && self._opts && self._opts.code && self._opts.code.regExp) || RegExp)({{=$schemaValue}}).test({{=$data}});
  } catch (e) {
    {{=$valid}} = false;
  }
  if ({{# def.$dataNotType:'string' }} !{{=$valid}}) {
